<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="neutrino-app.props" Condition="Exists('neutrino-app.props')" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0436</NoWarn>

    <!-- Utilities install into /bin (on $PATH) and declare the "utility"
         capability so npkg and the shell treat them as commands. -->
    <NeutrinoInstallPath>bin</NeutrinoInstallPath>
    <NeutrinoProvides>utility</NeutrinoProvides>
  </PropertyGroup>

  <Import Project="neutrino-app.targets" Condition="Exists('neutrino-app.targets')" />

</Project>
