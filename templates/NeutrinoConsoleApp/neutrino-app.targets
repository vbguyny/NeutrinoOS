<Project>

  <!--
    NeutrinoOS SDK - automatic .npkg packaging on Release builds.

    After a Release build the SDK runs the host npkg tool in SDK mode
    (npkg-host pack with name/version metadata and an entry dll for
    applications, or explicit payload files for libraries). The package
    lands next to the assembly, e.g. bin/Release/net10.0/MyApp.npkg.
  -->

  <Target Name="NeutrinoPack"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' And '$(NeutrinoPackageOnBuild)' == 'true'">

    <PropertyGroup>
      <NeutrinoPackageName Condition="'$(NeutrinoPackageName)' == ''">$(AssemblyName)</NeutrinoPackageName>
      <NeutrinoPackagePath>$(TargetDir)$(NeutrinoPackageName).npkg</NeutrinoPackagePath>
      <NeutrinoKeyArg Condition="'$(NeutrinoSigningKey)' != ''">--key "$(NeutrinoSigningKey)"</NeutrinoKeyArg>
      <NeutrinoPackCommonArgs>--name "$(NeutrinoPackageName)" --version "$(Version)" --architecture $(NeutrinoArchitecture) --install-path $(NeutrinoInstallPath) --provides $(NeutrinoProvides) --out "$(NeutrinoPackagePath)" $(NeutrinoKeyArg)</NeutrinoPackCommonArgs>
    </PropertyGroup>

    <Exec Condition="'$(OutputType)' == 'Exe'"
          Command="$(NeutrinoNpkgTool) pack --entry &quot;$(TargetPath)&quot; $(NeutrinoPackCommonArgs)" />

    <Exec Condition="'$(OutputType)' == 'Library'"
          Command="$(NeutrinoNpkgTool) pack --files &quot;$(TargetPath)&quot; $(NeutrinoPackCommonArgs)" />

    <Message Importance="high" Text="[NeutrinoOS] package: $(NeutrinoPackagePath)" />

  </Target>

</Project>
