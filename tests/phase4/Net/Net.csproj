<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>p4net</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- NeutrinoOS.Net provides the HTTP client; VirtioNet provides the entry
         point that reports the bound network stack. Both are boot-loaded
         assemblies on the NeutrinoOS side (like AppTest). -->
    <ProjectReference Include="../../../src/lib/NeutrinoOS.Net/NeutrinoOS.Net.csproj" />
    <ProjectReference Include="../../../src/drivers/shared/network/virtio-net/VirtioNet.csproj" />
  </ItemGroup>
</Project>
