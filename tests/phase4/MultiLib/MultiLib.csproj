<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>p4multi</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MathShared is deployed to /lib/MathShared.dll and resolved on
         demand by the kernel AssemblyLoader. -->
    <ProjectReference Include="SharedLibrary/MathShared.csproj" />
  </ItemGroup>
</Project>
