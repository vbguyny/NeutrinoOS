<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NeutrinoOS.DDK</AssemblyName>
    <RootNamespace>NeutrinoOS.DDK</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Note: DDK compiles against standard .NET BCL for convenience.
       At runtime, the kernel JIT resolves all types from korlib. -->

  <!-- NEUTRINO_TRACE (trace builds: TRACE=1): compiles the trace output
       in; otherwise Debug.* call sites are dropped by the compiler
       (see Kernel/Debug.cs). Passed by build/p5-apps-build.sh. -->
  <PropertyGroup Condition="'$(NeutrinoTrace)' == '1'">
    <DefineConstants>$(DefineConstants);NEUTRINO_TRACE</DefineConstants>
  </PropertyGroup>

</Project>
