<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 8 Task 4: standalone project for the shared packaging library so
       host tooling (SDK archive, NuGet consumers) can reference
       NeutrinoOS.Packaging.dll. The in-tree consumers (npkg CLI, npkg
       utility, repo server) compile the same sources directly via
       <Compile Include=...> to guarantee byte-for-byte behavior. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NeutrinoOS.Packaging</AssemblyName>
    <RootNamespace>NeutrinoOS.Packaging</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0436</NoWarn>
  </PropertyGroup>

  <!-- Ed25519 signing/verification comes from the DDK crypto library. -->
  <ItemGroup>
    <ProjectReference Include="../../ddk/DDK.csproj" />
  </ItemGroup>

</Project>
