<Project>

  <!--
    NeutrinoOS SDK - automatic .npkg packaging on Release builds.

    After a Release build the SDK runs the host npkg tool in SDK mode
    (npkg-host pack with name/version metadata and an entry dll for
    applications, or explicit payload files for libraries). The package
    lands next to the assembly, e.g. bin/Release/net10.0/MyApp.npkg.
  -->

  <Target Name="NeutrinoPack"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' And '$(NeutrinoPackageOnBuild)' == 'true'">

    <!-- Extra payload: referenced project outputs (libraries the app needs
         at run time) plus explicit items via the NeutrinoPayload item group. -->
    <ItemGroup>
      <_NeutrinoPayloadAll Include="@(NeutrinoPayload)" />
      <_NeutrinoPayloadAll Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceSourceTarget)' == 'ProjectReference' And '%(Extension)' == '.dll'" />
    </ItemGroup>

    <PropertyGroup>
      <NeutrinoPackageName Condition="'$(NeutrinoPackageName)' == ''">$(AssemblyName)</NeutrinoPackageName>
      <NeutrinoPackagePath>$(TargetDir)$(NeutrinoPackageName).npkg</NeutrinoPackagePath>
      <NeutrinoKeyArg Condition="'$(NeutrinoSigningKey)' != ''">--key "$(NeutrinoSigningKey)"</NeutrinoKeyArg>
      <NeutrinoExtraItems>@(_NeutrinoPayloadAll->'%(FullPath)', ',')</NeutrinoExtraItems>
      <NeutrinoEntryArg Condition="'$(OutputType)' == 'Exe'">--entry "$(TargetPath)"</NeutrinoEntryArg>
      <NeutrinoFilesArg Condition="'$(OutputType)' == 'Exe' And '$(NeutrinoExtraItems)' != ''">--files "$(NeutrinoExtraItems)"</NeutrinoFilesArg>
      <NeutrinoFilesList Condition="'$(OutputType)' != 'Exe' And '$(NeutrinoExtraItems)' != ''">$(TargetPath),$(NeutrinoExtraItems)</NeutrinoFilesList>
      <NeutrinoFilesList Condition="'$(OutputType)' != 'Exe' And '$(NeutrinoExtraItems)' == ''">$(TargetPath)</NeutrinoFilesList>
      <NeutrinoFilesArg Condition="'$(OutputType)' != 'Exe'">--files "$(NeutrinoFilesList)"</NeutrinoFilesArg>
      <NeutrinoPackCommonArgs>--name "$(NeutrinoPackageName)" --version "$(Version)" --architecture $(NeutrinoArchitecture) --install-path $(NeutrinoInstallPath) --provides $(NeutrinoProvides) --out "$(NeutrinoPackagePath)" $(NeutrinoKeyArg)</NeutrinoPackCommonArgs>
    </PropertyGroup>

    <Exec Command="$(NeutrinoNpkgTool) pack $(NeutrinoEntryArg) $(NeutrinoFilesArg) $(NeutrinoPackCommonArgs)" />

    <Message Importance="high" Text="[NeutrinoOS] package: $(NeutrinoPackagePath)" />

  </Target>

</Project>
