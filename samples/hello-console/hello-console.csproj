<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../sdk/build/NeutrinoOS.App.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>hellocon</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK packaging target walks project references, so hellolib.dll
         is included in hellocon.npkg automatically. -->
    <ProjectReference Include="../hello-library/hello-library.csproj" />
  </ItemGroup>

  <Import Project="../../sdk/build/NeutrinoOS.App.targets" />

</Project>
